# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite (zero config)
DATABASE_URL=sqlite+aiosqlite:///./agentstudio.db
# Staging/prod: Cloud SQL or AlloyDB
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/agentstudio

# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── LiteLLM Gateway ───────────────────────────────────────────────────────────
# Set USE_LITELLM=true to route all LLM calls through LiteLLM.
# Enables model fallbacks, cost tracking, and budget caps.
# Leave false to use direct provider SDKs (simpler local dev).
USE_LITELLM=false

# ── L2 Working Memory ─────────────────────────────────────────────────────────
# Omit (or leave blank) to use in-process dict — fine for single-process local dev.
# Set to Redis URL to enable cross-step shared memory (requires docker-compose redis).
# REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
